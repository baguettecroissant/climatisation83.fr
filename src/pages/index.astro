---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import StepsForm from '../components/StepsForm.astro';
import config from '../data/config.json';
import communes from '../data/communes.json';

const title = "Climatisation & Pompe à Chaleur Var (83) | Artisans RGE 2026";
const description = "Climatisation réversible & PAC air-air dans le Var (83). Obtenez 3 devis gratuits d'installateurs qualifiés RGE. Confort provençal et économies.";

// Show top 6 communes on home page
const featuredCommunes = communes.slice(0, 6);

// Fetch guides for internal linking
const guides = await getCollection('guides');
---

<Layout title={title} description={description} activeTab="home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container two-column-layout">
      <div>
        <span class="badge-pill" style="background:#E11D48; border-color:#FFE4E6; margin-bottom:15px; color:white;">
          🌴 Pose express 48h — tout le Var couvert 7j/7
        </span>
        <h1 style="font-size:42px; line-height:1.2; margin-bottom:20px; font-weight:700;">
          Climatisation réversible dans le Var (83)
        </h1>
        <p style="font-size:18px; margin-bottom:25px; opacity:0.95; line-height:1.6;">
          Les bastides provençales et les appartements du littoral méritent le meilleur du confort thermique. Équipez votre logement d'un split Inverter silencieux (19 dB) ou d'un gainable invisible régulé par zone. Divisez vos factures de chauffage par 3.
        </p>

        <div style="background:rgba(255,255,255,0.08); border:1.5px solid rgba(255,255,255,0.15); border-radius:15px; padding:20px; font-size:15px; line-height:1.6;">
          <strong>📊 Chiffres clés du marché varois :</strong>
          <ul style="list-style:none; margin-top:10px; display:flex; flex-direction:column; gap:8px;">
            <li>☀️ Climat : <span class="temp-fall-animate">🌡️</span> Canicules littorales humides et pics à <strong>40°C</strong> dans le haut-Var.</li>
            <li>🛠️ Artisans certifiés : <strong>90+ frigoristes agréés RGE Qualipac</strong> actifs dans le 83.</li>
            <li>⏱️ Devis : <strong>Étude de dimensionnement et devis gratuits</strong> sous 24 heures.</li>
          </ul>
        </div>
      </div>

      <div>
        <StepsForm />
      </div>
    </div>
  </section>

  <!-- Interactive Power Simulator -->
  <section style="padding:60px 0; background:white;">
    <div class="container" style="max-width:800px; text-align:center;">
      <h2 style="color:var(--primary); margin-bottom:15px;">Simulateur de puissance Climatisation</h2>
      <p style="color:var(--text-muted); margin-bottom:35px; font-size:16px;">
        Calculez la puissance en kW recommandée pour climatiser votre habitation dans le Var (83).
      </p>

      <div style="background:var(--primary-light); border:2px solid var(--border-color); padding:30px; border-radius:var(--radius-md); text-align:left; box-shadow:var(--shadow-sm);">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          <div class="form-group">
            <label for="sim-surface">Surface à équiper (m²)</label>
            <input type="number" id="sim-surface" class="form-control" value="45" min="10" max="250" />
          </div>
          <div class="form-group">
            <label for="sim-isolation">Qualité de l'isolation du bâti</label>
            <select id="sim-isolation" class="form-control" style="padding:0 15px;">
              <option value="0.8">Excellente (RT2020 / BBC / Villa moderne)</option>
              <option value="1.0" selected>Standard (RT2012)</option>
              <option value="1.3">Moyenne (Maison traditionnelle rénovée)</option>
              <option value="1.6">Ancien / Bastide provençale aux murs en pierre épais</option>
            </select>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:15px;">
          <div class="form-group">
            <label for="sim-orientation">Exposition au soleil</label>
            <select id="sim-orientation" class="form-control" style="padding:0 15px;">
              <option value="1.0">Nord (Ombragé / Collines)</option>
              <option value="1.1" selected>Est / Ouest (Ensoleillement modéré)</option>
              <option value="1.3">Sud / Sud-Ouest (Fort ensoleillement / canicule littorale)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="sim-etage">Situation thermique</label>
            <select id="sim-etage" class="form-control" style="padding:0 15px;">
              <option value="1.0" selected>Rez-de-chaussée / Appartement intermédiaire</option>
              <option value="1.2">Sous les toits / Villa à étage / Combles</option>
            </select>
          </div>
        </div>

        <div style="text-align:center; margin-top:30px; border-top:1px solid var(--border-color); padding-top:25px;">
          <span style="font-size:16px; color:var(--text-muted); display:block; margin-bottom:8px;">Puissance estimée requise :</span>
          <span id="sim-result" style="font-family:var(--font-mono); font-size:36px; font-weight:800; color:var(--secondary);">4.9 kW</span>
          <p style="font-size:13px; color:var(--text-muted); margin-top:8px;">
            *Estimation indicative. Un bilan thermique complet par un frigoriste certifié RGE du Var est requis avant toute pose.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Split vs Gainable Comparison -->
  <section style="padding:80px 0; background:var(--primary-light);">
    <div class="container">
      <div style="text-align:center; margin-bottom:50px;">
        <h2 style="color:var(--primary); margin-bottom:15px;">Comparateur de systèmes : Split vs Gainable</h2>
        <p style="color:var(--text-muted); font-size:16px; max-width:700px; margin:0 auto;">
          Choisissez la technologie de climatisation la plus adaptée aux contraintes esthétiques et thermiques de votre villa ou appartement varois.
        </p>
      </div>

      <div style="background:white; border:2px solid var(--border-color); border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-sm); overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:16px; min-width:600px;">
          <thead>
            <tr style="background:var(--primary); color:white;">
              <th style="padding:20px; font-weight:700; color:white;">Caractéristique</th>
              <th style="padding:20px; font-weight:700; color:white;">Split Mural réversible Premium</th>
              <th style="padding:20px; font-weight:700; color:white;">Climatisation Gainable Invisible</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom:1px solid var(--border-color);">
              <td style="padding:20px; font-weight:700; color:var(--primary);">Aspect visuel</td>
              <td style="padding:20px; color:var(--text-muted);">Unité compacte visible fixée en haut des parois</td>
              <td style="padding:20px; color:var(--text-muted);">Totalement invisible (grilles linéaires de soufflage encastrées)</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border-color);">
              <td style="padding:20px; font-weight:700; color:var(--primary);">Installation & Travaux</td>
              <td style="padding:20px; color:var(--text-muted);">Rapide (1 à 2 jours), sans modification structurelle majeure</td>
              <td style="padding:20px; color:var(--text-muted);">Intégration en plénum ou faux-plafond (3 à 5 jours de pose)</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border-color);">
              <td style="padding:20px; font-weight:700; color:var(--primary);">Gestion multizone</td>
              <td style="padding:20px; color:var(--text-muted);">Individuelle par split intérieur (avec télécommandes dédiées)</td>
              <td style="padding:20px; color:var(--text-muted);">Pièce par pièce intelligente (via technologie type Airzone)</td>
            </tr>
            <tr style="border-bottom:1px solid var(--border-color);">
              <td style="padding:20px; font-weight:700; color:var(--primary);">Acoustique intérieure</td>
              <td style="padding:20px; color:var(--text-muted);">Silencieux (jusqu'à 19 dB en mode nuit silencieux)</td>
              <td style="padding:20px; color:var(--text-muted);">Ultra-silencieux (moteur déporté en combles ou placard technique)</td>
            </tr>
            <tr>
              <td style="padding:20px; font-weight:700; color:var(--primary);">Budget moyen TTC posé</td>
              <td style="padding:20px; font-weight:700; color:var(--secondary); font-family:var(--font-mono);">1 200 € – 2 400 €</td>
              <td style="padding:20px; font-weight:700; color:var(--secondary); font-family:var(--font-mono);">4 800 € – 10 000 €</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Pricing section -->
  <section style="padding:80px 0; background:white;">
    <div class="container">
      <div style="text-align:center; margin-bottom:50px;">
        <h2 style="color:var(--primary); margin-bottom:15px;">Tarifs indicatifs climatisation dans le Var (2026)</h2>
        <p style="color:var(--text-muted); font-size:16px; max-width:750px; margin:0 auto;">
          Découvrez la grille tarifaire moyenne constatée pour l'achat et la pose d'un système thermodynamique réversible par un climaticien certifié dans le 83.
        </p>
      </div>

      <div class="grid-3">
        <div class="card" style="text-align:center;">
          <h3 style="color:var(--primary); margin-bottom:10px;">Split Mono-Mural</h3>
          <span class="price-tag" style="font-size:32px; color:var(--secondary); margin-bottom:15px; display:block;">1 200€ – 2 400€</span>
          <p style="font-size:15px; color:var(--text-muted); line-height:1.5; margin-bottom:20px;">
            Parfait pour une chambre ou un salon. Finition design compacte, filtres de purification de l'air, fluide écologique R32.
          </p>
          <a href="/devis/" class="btn-secondary" style="width:100%;">Demander un devis</a>
        </div>

        <div class="card" style="text-align:center; border-color:var(--secondary); transform: scale(1.03); box-shadow:var(--shadow-md);">
          <div style="background:var(--secondary); color:white; font-size:11px; font-weight:700; text-transform:uppercase; padding:4px 10px; border-radius:10px; display:inline-block; margin-bottom:15px;">Le plus demandé dans le 83</div>
          <h3 style="color:var(--primary); margin-bottom:10px;">Multi-Split (2-3 pièces)</h3>
          <span class="price-tag" style="font-size:32px; color:var(--secondary); margin-bottom:15px; display:block;">2 400€ – 5 800€</span>
          <p style="font-size:15px; color:var(--text-muted); line-height:1.5; margin-bottom:20px;">
            1 unité extérieure connectée à plusieurs splits intérieurs. Contrôle indépendant de la température par pièce et régulation Inverter.
          </p>
          <a href="/devis/" class="btn-primary" style="width:100%;">Demander un devis</a>
        </div>

        <div class="card" style="text-align:center;">
          <h3 style="color:var(--primary); margin-bottom:10px;">Gainable Centralisé</h3>
          <span class="price-tag" style="font-size:32px; color:var(--secondary); margin-bottom:15px; display:block;">4 800€ – 10 000€</span>
          <p style="font-size:15px; color:var(--text-muted); line-height:1.5; margin-bottom:20px;">
            Chauffage et climatisation 100% invisibles. Intégration esthétique optimale recommandée pour les villas neuves et bastides provençales.
          </p>
          <a href="/devis/" class="btn-secondary" style="width:100%;">Demander un devis</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Guides & Conseils Pratiques -->
  <section style="padding:80px 0; background:white; border-top: 2px solid var(--border-color);">
    <div class="container">
      <div style="text-align:center; margin-bottom:50px;">
        <h2 style="color:var(--primary); margin-bottom:15px;">Dossiers d'Experts &amp; Guides Pratiques</h2>
        <p style="color:var(--text-muted); font-size:16px; max-width:700px; margin:0 auto;">
          Retrouvez nos dossiers d'experts pour tout comprendre sur la climatisation réversible, les démarches ABF et les subventions applicables en 2026.
        </p>
      </div>

      <div class="grid-3" style="margin-bottom:40px;">
        {guides.map((guide) => (
          <div class="card" style="display: flex; flex-direction: column; justify-content: space-between; height: 100%;">
            <div>
              <span style="font-size: 12px; color: var(--text-muted); font-family: var(--font-mono); margin-bottom: 8px; display: block;">
                🗓️ Dossier Var (83)
              </span>
              <h3 style="font-size: 18px; color: var(--primary); margin-bottom: 12px; font-weight: 700;">
                <a href={`/guides/${guide.id}/`} style="text-decoration: none; color: inherit;">
                  {guide.data.title}
                </a>
              </h3>
              <p style="font-size: 14px; color: var(--text-muted); line-height: 1.5; margin-bottom: 20px;">
                {guide.data.description}
              </p>
            </div>
            <div>
              <a href={`/guides/${guide.id}/`} style="font-size:14px; font-weight:700; color:var(--secondary); text-decoration:none;">
                Lire la suite &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center;">
        <a href="/guides/" class="btn-secondary">Voir tous nos guides</a>
      </div>
    </div>
  </section>

  <!-- Localized towns list -->
  <section style="padding:60px 0; background:var(--primary-light);">
    <div class="container" style="text-align:center;">
      <h2 style="color:var(--primary); margin-bottom:15px;">Nos installateurs dans le Var</h2>
      <p style="color:var(--text-muted); font-size:16px; margin-bottom:40px; max-width:700px; margin:0 auto 40px;">
        Nous couvrons l'intégralité du département 83 pour l'étude de conception gratuite et l'installation de votre PAC air-air.
      </p>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:15px; text-align:left;">
        {featuredCommunes.map(c => (
          <a href={`/climatisation-${c.slug}/`} style="background:white; border:1px solid var(--border-color); padding:15px; border-radius:10px; text-decoration:none; display:flex; justify-content:space-between; align-items:center; transition:var(--transition); box-shadow:var(--shadow-sm);">
            <div style="display:flex; flex-direction:column;">
              <strong style="color:var(--primary); font-size:15px;">{c.nom}</strong>
              <span style="font-size:12px; color:var(--text-muted);">{c.codePostal}</span>
            </div>
            <span style="color:var(--secondary); font-weight:700;">&rarr;</span>
          </a>
        ))}
      </div>

      <div style="margin-top:35px;">
        <a href="/communes/" style="font-weight:700; color:var(--primary); text-decoration:none;">
          Voir toutes les communes couvertes (80+) &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive script for power simulator -->
  <script>
    const simSurface = document.getElementById('sim-surface') as HTMLInputElement;
    const simIsolation = document.getElementById('sim-isolation') as HTMLSelectElement;
    const simOrientation = document.getElementById('sim-orientation') as HTMLSelectElement;
    const simEtage = document.getElementById('sim-etage') as HTMLSelectElement;
    const simResult = document.getElementById('sim-result');

    const calculatePower = () => {
      if (!simSurface || !simIsolation || !simOrientation || !simEtage || !simResult) return;
      const surface = parseFloat(simSurface.value) || 0;
      const isolationFactor = parseFloat(simIsolation.value);
      const orientationFactor = parseFloat(simOrientation.value);
      const etageFactor = parseFloat(simEtage.value);

      // Base: 100W per m² for average conditions
      const powerWatts = surface * 100 * isolationFactor * orientationFactor * etageFactor;
      const powerkW = (powerWatts / 1000).toFixed(1);

      simResult.innerText = `${powerkW} kW`;
    };

    if (simSurface) {
      simSurface.addEventListener('input', calculatePower);
      simIsolation.addEventListener('change', calculatePower);
      simOrientation.addEventListener('change', calculatePower);
      simEtage.addEventListener('change', calculatePower);
    }
  </script>
</Layout>
