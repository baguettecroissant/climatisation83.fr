---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const title = "Tarif Climatisation Var (83) : Prix Matériel & Pose 2026";
const description = "Retrouvez les tarifs détaillés pour l'installation d'une climatisation réversible ou d'un gainable dans le 83. Prix du matériel, coût de pose, aides.";

const breadcrumbItems = [
  { label: "Accueil", url: "/" },
  { label: "Tarifs Installation Climatisation" }
];
---

<Layout title={title} description={description} activeTab="tarifs">
  <Breadcrumb items={breadcrumbItems} />

  <section style="padding: 50px 0 80px; background: white;">
    <div class="container" style="max-width: 900px;">
      <div style="text-align: center; margin-bottom: 50px;">
        <span class="badge-pill" style="margin-bottom: 15px; background:var(--secondary); color:white; border:none;">💰 Transparence des Tarifs</span>
        <h1 style="font-family: var(--font-heading); font-size: 36px; font-weight: 700; color: var(--primary); margin-bottom: 15px;">
          Prix d'une Climatisation Réversible dans le Var (83)
        </h1>
        <p style="font-size: 18px; color: var(--text-muted); line-height: 1.6;">
          Découvrez notre grille de tarifs indicatifs 2026 pour l'achat et la pose de climatisation réversible, pompe à chaleur air-air, gainable, ainsi que pour les prestations d'entretien dans le Var.
        </p>
      </div>

      <!-- Pricing Table -->
      <div style="background:var(--primary-light); border:2px solid var(--border-color); border-radius:var(--radius-md); overflow:hidden; margin-bottom:40px; box-shadow:var(--shadow-sm);">
        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:16px;">
          <thead>
            <tr style="background:var(--primary); color:white;">
              <th style="padding:15px; color:white; font-weight:700;">Type de matériel</th>
              <th style="padding:15px; color:white; font-weight:700;">Description de l'équipement</th>
              <th style="padding:15px; color:white; font-weight:700;">Prix TTC Posé</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--border-color); background:white;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Split mono mural</td>
              <td style="padding:15px; color:var(--text-muted);">2.5-3.5 kW, Inverter A+++, wifi, 19 dB, R32</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">1 200 € – 2 400 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:#f8fafc;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Bi-split mural</td>
              <td style="padding:15px; color:var(--text-muted);">2 unités intérieures, 1 groupe extérieur</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">2 400 € – 4 200 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:white;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Tri-split mural</td>
              <td style="padding:15px; color:var(--text-muted);">3 pièces, compresseur Inverter haut de gamme</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">3 200 € – 5 800 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:#f8fafc;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Quadri-split mural</td>
              <td style="padding:15px; color:var(--text-muted);">4 unités, maison complète, régulation intelligente</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">4 200 € – 7 500 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:white;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Gainable invisible</td>
              <td style="padding:15px; color:var(--text-muted);">Intégration faux-plafond, diffuseur linéaire, multi-zones</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">4 800 € – 10 000 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:#f8fafc;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">PAC réversible air-air</td>
              <td style="padding:15px; color:var(--text-muted);">Chaud + froid, SCOP A+++, COP 4.5+</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">3 000 € – 8 000 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:white;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Cassette plafond</td>
              <td style="padding:15px; color:var(--text-muted);">Diffusion d'air à 360°, idéal grand salon ou commerce</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">2 000 € – 4 000 €</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--border-color); background:#f8fafc;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Entretien annuel</td>
              <td style="padding:15px; color:var(--text-muted);">Nettoyage filtres, contrôle d'étanchéité et fluide R32</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">100 € – 200 €/an</td>
            </tr>
            <tr style="background:white;">
              <td style="padding:15px; font-weight:bold; color:var(--primary);">Mise aux normes R32</td>
              <td style="padding:15px; color:var(--text-muted);">Remplacement de l'ancien fluide par du R32 écologique</td>
              <td style="padding:15px; font-weight:bold; color:var(--secondary); font-family:var(--font-mono);">150 € – 350 €</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div style="background:white; border:2px solid var(--border-color); padding:30px; border-radius:var(--radius-md); margin-bottom:40px;">
        <h3 style="color:var(--primary); margin-bottom:12px; font-size:20px; font-weight:700;">Quels facteurs influencent le prix final dans le Var (83) ?</h3>
        <p style="font-size:15px; color:var(--text-muted); line-height:1.6; margin-bottom:15px;">
          Le coût total de votre projet de climatisation réversible dans le Var dépend principalement de :
        </p>
        <ul style="margin-left:20px; display:flex; flex-direction:column; gap:8px; font-size:15px; color:var(--text-muted);">
          <li>Le type de système et le choix des finitions (split mural classique ou intégration gainable invisible).</li>
          <li>La puissance requise (calculée selon le volume des pièces, l'exposition et le microclimat littoral humide vs arrière-pays caniculaire).</li>
          <li>Les contraintes de copropriété ou syndic (démarches Bâtiments de France ABF, discrétion esthétique et sonore).</li>
          <li>Le choix de la marque (Daikin, Mitsubishi Electric, Toshiba).</li>
        </ul>
      </div>

      <div style="text-align:center;">
        <a href="/devis/" class="btn-primary">Obtenir une estimation sur mesure</a>
      </div>
    </div>
  </section>
</Layout>
